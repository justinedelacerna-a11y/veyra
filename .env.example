# ==============================================================================
# VEYRA ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in ALL required values before running.
# NEVER commit .env.local or any real secrets to source control.
# ==============================================================================

# ==============================================================================
# BROWSER-SAFE VARIABLES (Exposed to the browser via NEXT_PUBLIC_ prefix)
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication (Browser)
# Get from: https://dashboard.clerk.com → API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_

# Clerk redirect paths (optional — matches default Veyra routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ------------------------------------------------------------------------------
# Supabase Cloud (Browser)
# Get from: https://supabase.com/dashboard → Project Settings → API Keys
# ------------------------------------------------------------------------------
# Your project base URL (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (formerly anon key) — safe for browser use; RLS enforces row security
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# SERVER-ONLY VARIABLES (NEVER expose to the browser or use NEXT_PUBLIC_ prefix)
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk Authentication (Server)
# Get from: https://dashboard.clerk.com → API Keys
# ------------------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_

# ------------------------------------------------------------------------------
# Supabase Cloud (Server)
# Get from: https://supabase.com/dashboard → Project Settings → API Keys
# ------------------------------------------------------------------------------
# Service role key — SERVER-SIDE ONLY. Bypasses RLS for trusted admin operations
# (Clerk webhook synchronization, PayMongo webhooks, cron maintenance).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# PayMongo (Future Placeholder — not yet active)
# Get from: https://dashboard.paymongo.com → Developers → API Keys
# ------------------------------------------------------------------------------
# PAYMONGO_PUBLIC_KEY=pk_test_
# PAYMONGO_SECRET_KEY=sk_test_
# PAYMONGO_WEBHOOK_SECRET=whsk_
